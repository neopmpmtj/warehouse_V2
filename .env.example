# --- Django ---
# Which settings module to use (default: dev). Production sets config.settings.prod
# DJANGO_SETTINGS_MODULE=config.settings.dev

# --- Secrets (REQUIRED in production) ---
# SECRET_KEY=change-me-in-production
# DEBUG=True

# --- Hosts ---
# Comma-separated. Production must set this (e.g. yourdomain.com,www.yourdomain.com)
# ALLOWED_HOSTS=localhost,127.0.0.1
# CSRF_TRUSTED_ORIGINS=https://yourdomain.com

# --- Database ---
# Local dev:  DATABASE_URL=postgresql://appuser:your_password_here@localhost:5432/centcompras_db
# Production: DATABASE_URL=postgresql://centcompras:STRONG_PASSWORD@localhost:5432/centcompras_db
# DATABASE_URL=

# POSTGRES_* vars remain a supported fallback for local dev when DATABASE_URL is unset:
# POSTGRES_USER=appuser
# POSTGRES_PASSWORD=your_password_here
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
